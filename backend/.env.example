# --- LLM: GitHub Copilot CLI (npm install -g @github/copilot, Node 22+) ---
COPILOT_BIN=copilot
# Empty = Copilot's default model. Or e.g. auto / a specific model id your plan allows.
COPILOT_MODEL=
# Optional. If empty, the CLI uses your /login session or `gh auth login`.
COPILOT_GITHUB_TOKEN=
COPILOT_TIMEOUT=240
COPILOT_CONCURRENCY=2

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=applyai

# Required: at least 16 random characters.  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: encrypts stored resumes at rest.  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173
# false = visible browser window (needed so you can solve CAPTCHAs / log in yourself)
HEADLESS=true
MAX_CONCURRENT_SESSIONS=3
\n# Persistent upload/screenshot directory (Docker Compose uses /app/storage)\nSTORAGE_DIR=/app/storage\n